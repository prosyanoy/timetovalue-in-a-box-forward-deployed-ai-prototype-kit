# Copy to .env if you want to override defaults. Nothing here is required and no secrets are needed.
SCENARIO=network-anomaly          # network-anomaly | predictive-maintenance
EVENT_RATE=5                      # synthetic events per second
ANOMALY_RATE=0.1
SEED=7
# Optional local LLM (any OpenAI-compatible server, e.g. Ollama). Empty = deterministic summaries.
LLM_BASE_URL=
LLM_MODEL=llama3.2
LLM_API_KEY=
